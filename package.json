{
  "name": "snowkey-battle",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start",
    "test": "npm run test:audio && npm run test:mobile-keyboard && npm run test:layout && npm run test:network && npm run typecheck && npm run build && node --experimental-strip-types --test tests/language.test.mjs && node --test tests/rendered-html.test.mjs && npm run test:word-pools && npm run test:engine",
    "test:network": "node --import ./tests/helpers/register-loader.mjs --test tests/room-socket.test.mjs tests/worker-room.test.mjs tests/online-typing.test.mjs tests/typing-input.test.mjs tests/online-rematch.test.mjs",
    "test:audio": "node --experimental-strip-types --test tests/game-audio.test.mjs",
    "test:mobile-keyboard": "node --experimental-strip-types --test tests/mobile-keyboard.test.mjs",
    "test:layout": "node --test tests/responsive-layout.test.mjs",
    "test:engine": "node --experimental-strip-types --test tests/room-engine.test.mjs",
    "test:word-pools": "node --experimental-strip-types --test tests/word-pools.test.mjs",
    "test:live": "npm run test:live:smoke && npm run test:live:reclaim",
    "test:live:smoke": "node tests/live-room-smoke.mjs",
    "test:live:reclaim": "node tests/live-room-reclaim.mjs",
    "test:browser": "node tests/browser-audit.mjs",
    "generate:wordbooks": "node scripts/generate-exam-wordbooks.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .local-previews --ignore-pattern worker-configuration.d.ts",
    "typecheck": "wrangler types --check && tsc --noEmit --incremental false",
    "deploy": "vinext deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --config dist/server/wrangler.json"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0",
    "ws": "8.21.1"
  },
  "overrides": {
    "postcss": "8.5.24"
  },
  "type": "module"
}
